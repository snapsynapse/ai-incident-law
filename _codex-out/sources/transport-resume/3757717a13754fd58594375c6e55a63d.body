	<script type="text/javascript">
		
		var useDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;

		tinymce.init({
			selector: 'textarea.editor',
			plugins: 'paste preview searchreplace autolink autosave directionality visualblocks visualchars fullscreen link codesample table hr pagebreak nonbreaking anchor insertdatetime advlist lists checklist wordcount imagetools textpattern noneditable help formatpainter permanentpen pageembed charmap tinycomments mentions quickbars linkchecker emoticons advtablen code',
			toolbar: 'undo redo | styleselect | bold italic | numlist | bullist|  ' +
      					'outdent indent | preview fullscreen | alignleft aligncenter alignright alignjustify |',
      		content_style: "body { font-family:  'Source Sans Pro', sans-serif; font-size:14px; line-height:normal;",
			paste_as_text: true,
			browser_spellcheck: true,
			default_link_target: '_blank',
			extended_valid_elements : "a[href|target=_blank]"
		});
	</script>

	<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>

	<script>
		(function () {
			// Bootstrap doesn't restore focus to the triggering control when a modal
			// is dismissed; without this, focus drops to <body> on every close.
			var focusReturnTargets = new WeakMap();

			// aria-modal alone isn't reliably honored by JAWS - it reads the dialog's
			// content but never announces "dialog". Making the rest of the page
			// genuinely inert while a modal is open is what fixes that. Walk down
			// from #main-content rather than inert-ing it wholesale, since these
			// modals are authored nested inside it - inert-ing main outright would
			// also inert the modal itself. Skip whichever branch actually contains
			// the open modal (and the backdrop, which isn't interactive anyway) and
			// inert every other branch alongside it. inert already implies
			// aria-hidden semantics per spec, but setting aria-hidden explicitly
			// too is cheap insurance against any JAWS-specific inert quirks.
			var inertedElements = new WeakMap();

			function setInertExceptFor(root, keepElement) {
				var made = [];
				Array.prototype.forEach.call(root.children, function (child) {
					if (child === keepElement || child.classList.contains('modal-backdrop')) {
						return;
					}
					if (child.contains(keepElement)) {
						made = made.concat(setInertExceptFor(child, keepElement));
						return;
					}
					var hadInert = child.hasAttribute('inert');
					var hadAriaHidden = child.hasAttribute('aria-hidden');
					if (!hadInert) {
						child.setAttribute('inert', '');
					}
					if (!hadAriaHidden) {
						child.setAttribute('aria-hidden', 'true');
					}
					if (!hadInert || !hadAriaHidden) {
						made.push({ el: child, hadInert: hadInert, hadAriaHidden: hadAriaHidden });
					}
				});
				return made;
			}

			document.addEventListener('show.bs.modal', function (event) {
				focusReturnTargets.set(event.target, event.relatedTarget || document.activeElement);
				var mainContent = document.getElementById('main-content');
				if (mainContent) {
					inertedElements.set(event.target, setInertExceptFor(mainContent, event.target));
				}
			});

			document.addEventListener('hidden.bs.modal', function (event) {
				var made = inertedElements.get(event.target);
				inertedElements.delete(event.target);
				if (made) {
					made.forEach(function (entry) {
						if (!entry.hadInert) {
							entry.el.removeAttribute('inert');
						}
						if (!entry.hadAriaHidden) {
							entry.el.removeAttribute('aria-hidden');
						}
					});
				}

				var target = focusReturnTargets.get(event.target);
				focusReturnTargets.delete(event.target);
				if (target && typeof target.focus === 'function') {
					target.focus();
				}
			});
		})();
	</script>

