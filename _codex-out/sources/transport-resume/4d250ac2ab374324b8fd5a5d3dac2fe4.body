                                    <div id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_pnlMediaNotif">
		
                                            <section title="Case Subscriptions">
                                        <div class="row p-2">
                                            <div class="col-12 d-flex flex-column  flex-md-row justify-content-start p-3">
                                                 <div class="pr-2"><h3 class="dcoSearchHeading" style="font-size:16px;">Case Subscriptions</h3></div>
                                                 <div class="pr-2"><a id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_Hyperlink1" title="opens in a new window" href="../../InstructionalDocs/HCDCWebSite_New%20Features_AttorneyCaseSubs.pdf" target="_blank"><u>View Instructions</u></a></div>
                                            </div>

                                            <div class="col-12">
                                                You can subscribe for notifications to a specific case
                                                <span id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_lblPtyofRec2"> for which you are not the Attorney of Record</span>
                                                to receive automatic e-mail notifications of new events pertaining to that case.
                                                You can select which events (Dockets, Documents/Filings, and/or Judgments/Order).
                                            </div>

                                            <div class="col-12 mt-3">
                                                Note: You can have a maximum of
                                                <span id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_lblNumCases">30</span>
                                                active notifications.
                                            </div>

                                            <div class="col-12 mt-3">

                                                

                                            </div>

                                            <div class="col-12 text-center mt-4">
                                                 <a id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_HPLSubscriptions" title="opens in a new window" class="btn dcoButtons" href="../Secure/SubscriptionWizard.aspx" target="_blank">Manage Case Subscriptions</a>                               
                                            </div>

                                            <table class="contentwidth" cellpadding="0" cellspacing="0" border="0">
                                               
                                            </table>

                                            

                                            

                                           

                                           

                                        </div>
                                            </section>
                                    
	</div>
                          
