                background:inherit;
            }

            #sTabs.tab-wrap #tabs.nav-tabs input.nav-link[aria-selected="false"]:hover {
                color: #8fcafa;
                cursor:pointer;
            }

	</style>

    <script type="text/javascript">

        //observer code allows us to read the navigation object at the correct time, so we can log or not depending on it's value'
        const observer = new PerformanceObserver((list) => {
            // Get the PerformanceNavigationTiming object for the most recent navigation event
            let perfEntries = list.getEntriesByType('navigation');
            if (perfEntries.length > 0) {

                let navType = perfEntries[0].type;
                document.cookie = 'navType=' + navType + '; path=/';

            }
        });

        /*call the observer*/
        observer.observe({ type: 'navigation', buffered: false });

        $(document).ready(function () {
            $('.datePick').datepicker({
                format: "mm/dd/yyyy"
            });

            //prevents user from entering a date in the future.
            setDtLimits();
            setDtRngDockets();
            //--Wcag.js function, describes search results pager to sightless users. (example: page 1 of 2)
            describeSearchPager();

            /*Wcag.js function, Google creates input tags with no labels for their translate control. It creates a false positive in the f12 console, 
            so we add arialabel and a placeholder to resolve the error and tell anybody who might somehow focus it to disregard.*/
            fixGoogleErrors();
        });

    </script>

    <script>

        $(document).ready(function () {
            
            var mql = window.matchMedia("screen and (min-width: 915px)");
            //for large screens.

            if (document.getElementById("hdnActiveTab").value === "" && mql.matches) {
                setActiveTab('tabCivilMobile');
            };


            // Add minus icon for collapse element which is open by default
            $(".collapse.show").each(function () {
                $(this).prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
            });

            // Toggle plus minus icon on show hide of collapse element
            $(".collapse").on('show.bs.collapse', function () {
                $(this).prev(".card-header").find(".fa").removeClass("fa-plus").addClass("fa-minus");
            }).on('hide.bs.collapse', function () {
                $(this).prev(".card-header").find(".fa").removeClass("fa-minus").addClass("fa-plus");
            });
            
            var aTab = document.getElementById("hdnActiveTab").value;
            //1 statement below handles toggle of +/- icon of the currently selected tab.
            if (aTab) {
                $('#' + aTab).find(".fa").addClass("fa-minus").removeClass("fa-plus");
            } 
            var eleToFocus = '';
            switch (aTab) {
                case 'tabCivilMobile':
                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $("#tabCiv").tab('show');
                    $('#civTabContent').addClass('show');
                    
                    //$('#civTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'txtCaseNumber';


                    break;

                case 'tabCrimMobile':

                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $("#tabCrim").tab('show');
                    $('#crimTabContent').addClass('show');
                    //$('#crimTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'txtCrimCaseNumber';
                    break;

                case 'tabParMobile':

                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $('#partyTabContent').addClass('show');
                    
                    //$('#partyTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'txtPartyName';
                    break;

                case 'tabBackMobile':
                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $('#backTabContent').addClass('show');
                    //$('#backTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'txtSPN2';
                    break;

                case 'tabHistMobile':
                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $('#histTabContent').addClass('show');
                    //$('#histTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'txtSearch';
                    break;

                case 'tabVerdMobile':
                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $('#verdTabContent').addClass('show');
                    //$('#verdTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'txtCaseNumberverdicts';
                    break;

                case 'tabSpecMobile':
                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $('#specTabContent').addClass('show');
                    //$('#specTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'caseNumberTextbox';
                    break;

                case 'tabDocMobile':
                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $('#docTabContent').addClass('show');
                    //$('#docTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'txtDocketStartDateMobile';
                    break;

                case 'tabSubsMobile':
                    $('.nav-tabs a[href="#' + aTab + '"]').tab('show');
                    $('#subsTabContent').addClass('show');
                    //$('#subsTabContent').prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    scrollTabIntoView(aTab);
                    eleToFocus = 'lblPtyofRecTitle';
                    break;

                default:
                    setActiveTab('tabCivilMobile');
                    $("#tabCiv").tab('show');
                    $('#civTabContent').addClass('show');
                    $('#tabCivilMobile').find(".fa").addClass("fa-minus").removeClass("fa-plus");
                    eleToFocus = 'tabCiv';
                    break;

            }

            focusElement('lblPgTit');
            focusElement(eleToFocus);
            focusElement('lblError');

            let eles = document.getElementsByClassName('fsErrorList');
            let lgNav = document.getElementById('tabs');
            if (lgNav) {
                if (getComputedStyle(lgNav).display === 'none') {
                    focusIfError(eles[1]);
                } else {
                    focusIfError(eles[0]);
                }
            }

            
            

            

            //refactored into single statement above 05/09/23
            //if (aTab === 'tabCivilMobile') {

            //};

            //if (aTab === 'tabCrimMobile') {

            //};

            // if (aTab === 'tabParMobile') {

            //};

            // if (aTab === 'tabBackMobile') {

            //};

            //if (aTab === 'tabHistMobile') {

            //};

            //if (aTab === 'tabVerdMobile') {

            //};

            //if (aTab === 'tabSpecMobile') {

            //};

            //if (aTab === 'tabDocMobile') {

            //};

            //if (aTab === 'tabSubsMobile') {

            // };

            // if (aTab == '') { //on page load: Civil is active tab on larger devices

            // };



            //WCAG: set aria-active property so that screen reader users can understand what tab they are on.
            //called from WCAG.js
            /*setAriaActiveSearch(activeTabID);*/

        });
         //end of document.ready

        //prevents user from entering a date before 1837 or after todays date 
        function setDtLimits() {
            let dateEles = document.getElementsByClassName('date');
            for (let i = 0; i < dateEles.length; i++) {
                if (dateEles[i]) {
                    //2 func below called from wcag.js
                    setMaxDt(dateEles[i]);
                    setMinDt(dateEles[i]);
                }
            }

            let smlDateEles = document.getElementsByClassName('smalldate');
            for (let i = 0; i < smlDateEles.length; i++) {
                setMinPartyDt(smlDateEles[i]);
                setMaxDt(smlDateEles[i]);
            }
        }
        function setMinPartyDt(Ctrl) {
                if (Ctrl) {
                    Ctrl.min = '1900-01-02';
                }
        }


    </script>

