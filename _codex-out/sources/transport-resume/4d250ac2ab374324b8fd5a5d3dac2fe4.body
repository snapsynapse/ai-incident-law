        function showDefendantFilter(sender, targetID) {
            var target = window.document.getElementById(targetID);
            if ((typeof sender !== "undefined" && sender.value !== "") && (typeof target !== "undefined")) {
                target.style.display = "block";
            } else {
                target.style.display = "none";
            }
        }

        function toggleDefendantFilter(targetID) {

            var target = window.document.getElementById(targetID);
            if (typeof target !== "undefined" && target.style.display === "") {
                target.style.display = "block";
            }
        }

        function setActiveTabMobile(tab, expandedTab) {
            resetOnTabSwitch();
            setActiveTab(tab)
            $("#" + expandedTab).tab('show');
        }

        function setActiveTabExpanded(tab, tabContent) {
            resetOnTabSwitch();
            setActiveTab(tab)
            //collapse any expanded tab
            $(".tabc").removeClass('show');

            //Don't need to trigger a "prev" statement due to tab nesting update. (11/28/23)
            //$(".tabc").prev(".card-header").find(".fa").removeClass("fa-minus").addClass("fa-plus");
            $(".card-header").find(".fa").removeClass("fa-minus").addClass("fa-plus");

            //expand active tab to match active tab on expanded nav
            $("#" + tabContent).addClass('show');
            $("#" + tabContent).prev(".card-header").find(".fa").addClass("fa-minus").removeClass("fa-plus");
        }

        function setActiveTab(tab) {

            document.getElementById("hdnActiveTab").value = tab;
            scrollTabIntoView(tab);

            if (tab == 'tabHistMobile') {
                document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_btnSecHistDocs').click();
           }
        };

        function setBackTab(expanded) {
            if (expanded) {
                setActiveTabExpanded('tabBackMobile', 'backTabContent')
            } else {
                setActiveTabMobile('tabBackMobile', 'backTab');
            };

            if (!$('#backTabContent').hasClass('show') || expanded) {
                document.getElementById("abackgrndchecknew").click();
            };
        };

        function setAgeDate() {
            var dobBegin = window.document.getElementById("txtDOB"),
                dobEnd = window.document.getElementById("txtDOBEnd"),
                ageBegin = window.document.getElementById('txtAgeBegin'),
                ageEnd = window.document.getElementById('txtAgeEnd'),
                begin = new Date(),
                end = new Date();

            if (typeof ageBegin !== "undefined" && ageBegin.value > 0) {
                begin.setFullYear(begin.getFullYear() - ageBegin.value);
                //Sets date format correctly for values less than 10(IE: 1/1/2012 should be 01/01/2012)
                var month = checkDtFormat(begin.getMonth() + 1);
                var day = checkDtFormat(begin.getDate());
                dobEnd.value = begin.getFullYear() + "-" + month + "-" + day;

                begin.setDate(begin.getDate() + 1);
                begin.setFullYear(begin.getFullYear() - 1);

                var month = checkDtFormat(begin.getMonth() + 1);
                var day = checkDtFormat(begin.getDate());
                dobBegin.value = begin.getFullYear() + "-" + month + "-" + day;

                if (typeof ageEnd !== "undefined" && (ageEnd.value - ageBegin.value) > 0) {
                    end.setFullYear(end.getFullYear() - ageEnd.value - 1);
                    end.setDate(end.getDate() + 1);

                    var month = checkDtFormat(end.getMonth() + 1);
                    var day = checkDtFormat(end.getDate());
                    dobBegin.value = end.getFullYear() + "-" + month + "-" + day;
                }
            }
        }

        function checkDtFormat(num) {

            if (num < 10 && num > 0) {
                num = '0' + num;
                return num;
            } else {
                return num;
            }

        }

        function KeyPressHandler(evt) {

            if (window.event) {
                //The global window.event will be set in IE4-6 
                var key = evt.keyCode;
            }
            else {

                var key = evt.which;
            }

            if ((key < 48 || key > 57) && key > 20) {
                return false;
            }

        }

        function Cover(bottom, top, adjustSize) {
            var bottm = Sys.UI.DomElement.getLocation(bottom);
            top.style.position = 'absolute';
            top.style.zindex = 99;
            top.style.top = bottm.y + 172 + 'px';
            top.style.left = bottm.x - 30 + 'px';
            if (adjustSize) {

            }
        }

