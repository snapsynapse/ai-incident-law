        function ViewCaseNotification(strCaseNbr, strCDI) {
            var objCaseDetail;
            var url = '../Secure/SubscriptionWizard.aspx?Case=' + strCaseNbr + '&CDI=' + strCDI;
            var windowTitle = strCaseNbr + '_' + strCDI;
            objCaseDetail = window.open(url, windowTitle, 'height=550,width=940,menubar=no,resizable=yes,scrollbars=yes,toolbar=no');
            if (objCaseDetail == null) {
                // Popups blocked redirect the user to another page.			    
                alert('Popups are being blocked by your browser. Please enable popups to view case (cause) information.');
            }
            objCaseDetail.focus();
        }

        function ViewFaxFile(strCaseNbr, strCDI) {
            var objCaseDetail;
            var url = '../Secure/FREEfax/Secure/subpoena.aspx?CaseNbr=' + strCaseNbr + '&CDI=' + strCDI;
            var windowTitle = strCaseNbr + '_' + strCDI;
            objCaseDetail = window.open(url, windowTitle, 'height=550,width=940,menubar=yes,resizable=yes,scrollbars=yes,toolbar=yes');
            if (objCaseDetail == null) {
                // Popups blocked redirect the user to another page.			    
                alert('Popups are being blocked by your browser. Please enable popups to view case (cause) information.');
            }
            objCaseDetail.focus();
        }

        function VieweNoticesFile(queryString) {
            var objCaseDetail;
            var url = '../Secure/FREEfax/Secure/eNotices.aspx?' + queryString
            var windowTitle = 'Pro Se eNotices';
            objCaseDetail = window.open(url, windowTitle, 'height=9000,width=1140,,left=400,top=50, menubar=yes,resizable=yes,scrollbars=yes,toolbar=yes');
            if (objCaseDetail == null) {
                alert('Popups are being blocked by your browser. Please enable popups to view case (cause) information.');
            }
            objCaseDetail.focus();
        }

        function changeColor(id, color) {
            element = document.getElementById(id);
            event.cancelBubble = true;
            oldColor = element.currentStyle.background;
            element.style.background = color;
        }

        function viewDocs(e) {
            document.getElementById(e).click();
        }

        function showSearchButtons() {
            var e = document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_divSearchButtons');
            e.style.display = 'block';
        }

        function hideSearchButtons() {
            var e = document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_divSearchButtons');
            e.style.display = 'none';
        }

        function hideSearchButtonsForCivilAndCriminal() {
            if (document.getElementById('hdnLogout').value == '0') {
                var e = document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_divSearchButtons');
                e.style.display = 'none';
            } else {
                showSearchButtons();
            }
        }

        function LoadSearchPage() {
            window.location.href = '../Public/Search.aspx';
        }


       

        /*
        var ImageViewerWindow;
        function ViewDoc(queryString) {
        ImageViewerWindow = window.open('ViewFilePage.aspx?Get=' + queryString, '_blank', 'height=800,left=270,top=100,menubar=no,resizable=yes,scrollbars=no,toolbar=no,width=650');
        }

        function ViewVerdictDoc(ImageNbr, strCaseNbr, strCDI, CourtID, isVerdicts) {
        ImageViewerWindow = window.open('ViewFilePage.aspx?ViewVerdict=1&ViewAsType=PDF&strCaseNbr=' + strCaseNbr + '&strCDI=' + strCDI + '&PublicImageNbr=' + ImageNbr + '&CourtID=' + CourtID, ImageNbr, 'height=800,left=270,top=100,menubar=no,resizable=yes,scrollbars=no,toolbar=no,width=650');
        }
        */

        // -->

        function showAudioCaptcha(division) {

            /*variables that need to change based on division*/
            var hdnSRC = document.getElementById('hdn' + division + 'AudioSRC');
            var btn = document.getElementById(division + 'BtnAudioCaptcha');
            var ctrlSRC = document.getElementById(division + 'AudioSRC');
            var audioCTRL = document.getElementById(division + 'AudioCtrl');

            /* grabs audio source and loads it into html tag*/
            ctrlSRC.src = hdnSRC.value;
            audioCTRL.load();

            /* toggles visibility of buttons */
            if (audioCTRL.classList.contains('d-none')) {
                audioCTRL.classList.remove('d-none');
                audioCTRL.classList.add('d-block');
                btn.classList.add('d-none');
            }

            hdnSRC.value = '';
            audioCTRL.focus();
        }

        function resetOnTabSwitch() {
            //reset the form when user changes tabs. Prevents locking up the page on the front end when an element is not visible but is still validated.
            document.getElementById("aspnetForm").reset();
            //clear error messages when user changes tabs.
            let errMsgs = document.getElementsByClassName('fsErrorList');
            if (errMsgs.length > 0) {
                for (let i = 0; i < errMsgs.length; i++) {
                    errMsgs[i].textContent = '';
                }
            }
        }

    </script>


