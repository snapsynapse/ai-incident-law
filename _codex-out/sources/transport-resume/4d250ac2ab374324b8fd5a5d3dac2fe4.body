<script type="text/javascript">

    if (!!window.performance && window.performance.navigation.type === 2 && window.location.href.indexOf("kiosk") > -1) {
        window.location.reload();
    }

    function toggleEyeLogin(ele, obj) {
        var type = ele.getAttribute('type') === 'password' ? 'text' : 'password';
        ele.setAttribute('type', type);
        obj.toggleClass("fa-eye fa-eye-slash");
    }
    $(document).ready(function () {
        let pwdIcon = document.getElementById('nPwdIconLogin');
        if (pwdIcon) {
            pwdIcon.addEventListener('click', function (e) {
                toggleEyeLogin($("[id$='txtPassword']")[0], $(this));
            });
        }


        LoginAnnounementOnload();


    });

       
</script>

