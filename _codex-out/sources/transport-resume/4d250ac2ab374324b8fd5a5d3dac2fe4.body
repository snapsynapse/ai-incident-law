                                    <section title="Client/PartyNotifications">

                                    <div class="row p-2">

                                         <div class="col-12 d-flex flex-column  flex-md-row justify-content-start p-3">
                                                 <div class="pr-2">
                                                     <h3 class="dcoSearchHeading" style="font-size:16px;"><span id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_lblClientParty">Client/Party</span>Notifications</h3>
                                                 </div>
                                                 <div class="pr-2"> <a id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_Hyperlink2" title="opens in a new window" href="../../InstructionalDocs/HCDCWebSite_New%20Features_AttorneyPartySubs.pdf" target="_blank"><u>View Instructions</u></a></div>
                                        </div>

                                        <div class="col-12">
                                              Build a <span id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_lblClientParty1">Client/Party</span>
                                            list and receive an automatic e-mail notification when a new petition is filed with
                                            our office that names a  <span id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_lblClientParty2">Client/Party</span>
                                            identified on your <span id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_lblClientParty3">Client/Party</span> list.
                                        </div>

                                        <div class="col-12 mt-3">
                                            Note: You can have a maximum of <span id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_lblNumParties">50</span> active notifications.
                                        </div>

                                        <div class="col-12 mt-3">
                                             

                                        </div>

                                        <div class="col-12 text-center mt-4">
                                                <a id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_HPLPartySubscriptions" title="opens in a new window" class="btn dcoButtons" href="../Secure/PartySubscriptions.aspx" target="_blank">Manage Client/Party Notifications</a> </div>
                                        </div>

                                     

                                       

                                      

                                       

                                       

                                       </section>

                                
	</div>               
