    }

    .messageContainer.message a {
        /* Changed to meet color contrast requirements 06/18/26 */
        /*color:#00020e;*/
        color: #fff;
        /* Color should not be the only indicator of a link https://www.w3.org/TR/WCAG21/ */
        text-decoration:underline;
    }

</style>

<script type="text/javascript">
    // Announcing message status for screen reader users
    $(document).ready(function () {
        if (ThePageHasMessages()) {
            announceMessageStatus();
        }
    });

    function ThePageHasMessages() {
        let checkEle = document.getElementById('SystemMessagesList');
        if (checkEle) {
            return true;
        } else {
            return false;
        }
    }

    function announceMessageStatus() {
        let announceEle = document.getElementById('notificationsAnnouner');
        if (announceEle) {
            announceEle.innerHTML = 'There are system messages. go to the System Messages heading then press down to view them.';
        }
    }
</script>


