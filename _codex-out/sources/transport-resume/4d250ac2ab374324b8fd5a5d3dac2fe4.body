 <script  type="text/javascript">

     function toggleGetStart() {

         var x = document.getElementById("getStartInfo");
         var btn = document.getElementById("brnGetStart");
         var lnk = document.getElementById("lblGetStart")
         if (x.style.display === "none") {
             x.style.display = "block";
             lnk.innerText = "Hide Getting Started";
         } else {
             x.style.display = "none";
             lnk.innerText = "Getting Started";
         }
     }

     function validateYear() {
         var input = document.getElementById('txtNatYear').value;
         var lblYearError = document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_lblYearError');
         var btnHDSearch = document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_btnHDSearch');
         var year = parseInt(input);

         if (year < 1837 || year > 1913) {
             lblYearError.style.display = 'inline';
             lblYearError.innerText = 'No record for this year';
         } else {
             lblYearError.style.display = 'none';
         }
     }
 </script>

