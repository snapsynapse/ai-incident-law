        function ChkCaseNbr(obj, str, cdi) {
            document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_hdnCaselnk').value = str;
            document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_btnPin').click();
            document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_hdnCDI').value = cdi;
          }

          function getcasenbr() {
              document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_HfCaseNbr').value = document.getElementById('txtCaseNumber').value;
            document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_HfCaseCdi').value = document.getElementById('ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_hdnCDI').value;
        }



        function OpenRequestPin(queryString) {           
                window.open('../Secure/RequestPin.aspx?' + queryString, '_blank');
        }

        function OpenCaseDetailTab(queryString) {      
           
            window.open('CaseDetails.aspx?' + queryString, '_blank');
        }


            function scrollTabIntoView(tab) {          
          
            var mql = window.matchMedia("screen and (min-width: 915px)")
            if(mql.matches) { return;}  //don't scroll on large devices
            var el = document.getElementById(tab);
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            var scrolledY = window.scrollY;
            //alert(scrolledY);
            if(scrolledY){
                //window.scroll(0, scrolledY - 100);
                window.scroll(0,100)
            };

        };
     

        function scrollTabIntoViewx(tab) {          
          
            var mql = window.matchMedia("screen and (min-width: 915px)")
            if(mql.matches) { return;}  //don't scroll on large devices
            var el = document.getElementById(tab);
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            var scrolledY = window.scrollY;
            alert(scrolledY);
            if(scrolledY){
                //window.scroll(0, scrolledY - 100);
                window.scroll(0,254)
            };
        };




       

      </script>  
   
