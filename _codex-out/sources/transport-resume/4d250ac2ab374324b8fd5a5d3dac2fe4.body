<section id="secHistDocs" title="historical documents search">

    <div id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_pnlHistoricalDocument">
		

        <div id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_udpnlDocuments">
			

                                      

                <h3 class="dcoSearchHeading visually-hidden">HISTORICAL SEARCH</h3>
    

                <div class="row">
                    <div class="col-12">The District Clerks Office observes the recommendations from The Texas State Library Archive Commission for preservation of historical records. Our preservation efforts focus on records dating from 1837-1951. We are also in the process of digitizing these records to make them easily accessible online.</div><br /><br />
                </div>
                <div class="grid-container">

                    <div class="sidebar">
                        <div class="row">
                            <div class="col-12 col-md-12 mb-2">
                                <h4 style="font-weight: bold; font-size: 14pt;">Historical Records</h4>
                                <div style="font-style: italic; margin-bottom: 8px;">To search historical records, select a type of case (Civil/Family or Criminal):</div>
                                <a  Class="btn dcoButtons Buttons"  href="../../eDocs/Public/Search.aspx?Civil=1&Tab=tabCivilMobile" >Civil / Family</a>
                                <a  Class="btn dcoButtons Buttons"  href="../../eDocs/Public/Search.aspx?Criminal=1&Tab=tabCrimMobile" >Criminal</a>
                                <div style="font-weight: bold; color:#0055A5; margin-top: 14px; margin-bottom: 4px;" >Information required for search<br /></div>
                                <ul style="color:#0055A5;">
                                    <li>Case (cause) number</li>
                                    <li>Style (person(s) involved in a case)</li>
                                    <li>Date Range</li>
                                </ul>
                                <p style="color:#d10000">  If required information listed above is not available, a <i>primary information</i> search is necessary.  This search involves an additional $5.00 fee.
                                    <a href="../../eDocs/Secure/RequestNADocuments.aspx" class="linkToPage">Click here</a> to conduct <i>primary information</i> search. </p><br />
                            </div>
                         </div>
                    </div>

                <div class="content" style="padding: 0px 0px 0px 18px;">
                    <div class="row">
                        <div class="col-12">
                            <h4 style="font-weight: bold; font-size: 14pt;">Naturalization Records:</h4>
                                The Harris County Naturalization Records Index dates from 1837-1913.<br /><br />
                            <p style="color:#d00">  Note: For research of Naturalization records after 1913, Please Contact the USCIS, federal government:
                                <a href="https://www.uscis.gov/" class="linkToPage">www.uscis.gov</a></p>
                        </div>
                    </div>
                    <fieldset class="row mt-2 makeInline">
                        <legend>
                            <div class="col-12 col-md-2">
                                <label for="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_txtLastName" style="margin: 0px; color: Black; font-weight:bold"> Petitioner:</label>
                            </div>         
                        </legend>
                        <div class="col-12 col-md-6 text-left">
                            <input name="ctl00$ctl00$ctl00$ContentPlaceHolder1$ContentPlaceHolder2$ContentPlaceHolder2$historicalCtrl$txtLastName" type="text" maxlength="100" id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_txtLastName" placeholder="Last name" style="width: 200px;" />
                            <input name="ctl00$ctl00$ctl00$ContentPlaceHolder1$ContentPlaceHolder2$ContentPlaceHolder2$historicalCtrl$txtFirstName" type="text" maxlength="100" id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_txtFirstName" placeholder="First name" style="width: 200px;" />              
                        </div>
                    </fieldset>  
            
                    <div id="natYearDiv" class="row mt-2">
                        <div class="col-12 col-md-2">
                             <label for="txtNatYear" style="margin: 0px; color: Black; font-weight:bold">Year</label>               
                        </div>
                        <div class="col-12 col-md-10 text-left" >
                            <input name="ctl00$ctl00$ctl00$ContentPlaceHolder1$ContentPlaceHolder2$ContentPlaceHolder2$historicalCtrl$txtNatYear" type="number" maxlength="4" id="txtNatYear" min="1837" max="1913" placeholder="example: 1837" value="" oninput="validateYear()" style="width: 115px;" />
                            <span id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_lblYearError" style="color: #e50000"></span> 
                        </div>
                    </div>

                    <div id="natCountryDiv" class="row mt-2">
                        <div class="col-12 col-md-2">
                            <label for="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_ddlNatCountry" style="margin: 0px; color: Black; font-weight:bold">Country of Origin</label>               
                        </div>
                        <div class="col-12 col-md-10 text-left">
                            <select name="ctl00$ctl00$ctl00$ContentPlaceHolder1$ContentPlaceHolder2$ContentPlaceHolder2$historicalCtrl$ddlNatCountry" id="ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_historicalCtrl_ddlNatCountry" style="width: 200px;">
				<option value="Country Of Origin" style="color:Gray;font-style:italic">Country Of Origin</option>
				<option value="NCYUK">United Kingdom</option>
				<option value="NCYHT">Haiti</option>
				<option value="NCYNO">Norway</option>
				<option value="NCYUN">Unknown</option>
				<option value="NCYIE">Ireland</option>
				<option value="NCYCH">Switzerland</option>
				<option value="NCYIN">India</option>
