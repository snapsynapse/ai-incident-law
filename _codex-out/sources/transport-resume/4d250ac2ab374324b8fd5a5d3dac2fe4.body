    <script language="javascript" type="text/javascript">
        <!--
    function getParentValue() {
        var Url = window.document.getElementById("ctl00_ctl00_ctl00_ContentPlaceHolder1_ContentPlaceHolder2_ContentPlaceHolder2_lblHiddenURL").innerHTML;
            return Url;
