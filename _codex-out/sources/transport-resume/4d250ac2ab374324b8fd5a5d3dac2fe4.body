        position: absolute;
        float: right;
        top: 3px;
        height: 15px;
    }
    .add
    {
        right: 3px;
        background: url(../../images/spriteClose.png) no-repeat 0px -350px;
        width: 14px;
        cursor: pointer;
        position: absolute;
        top: 20px;
        height: 15px;
        margin: 0px;
        padding: 0px;
