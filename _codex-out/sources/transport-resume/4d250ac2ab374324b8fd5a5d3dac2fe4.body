       <script type="text/javascript">

           //wcag: remove class to collapse menu when btn is clicked.
           function collapseNav(toggleID, idToCollapse) {
               var toggleEle = document.getElementById(toggleID);
               var collapseEle = document.getElementById(idToCollapse);
               if (toggleEle.ariaExpanded == 'false') {
                   //remove navHeight so that dcoHeaderLimit can work properly
                   if (collapseEle.classList.contains('smNavHeight')) {
                       collapseEle.classList.remove('smNavHeight');
                   }
               } else {
                   //collapse main menu and restore nav height
                   collapseEle.classList.remove('dcoHeaderLimit');
                   if (!collapseEle.classList.contains('smNavHeight')) {
                       collapseEle.classList.add('smNavHeight');
                   }
               }
           }

           // $.getScript(dco.hcdistrictclerk + "/Angular/Directives/Website/Passport/dcoPassport.js" );
           $(document).ready(function () {
               //wcag function, prevents html5 elements from interferring with login fields.
               applyLoginEventListeners();
               applyFaqFix();
               // --------------------------     ON SCROLL FUNCTIONS


               $(window).scroll(function () {

                   $('.dropdown-menu').collapse('hide');

               });

               // --------------------------     NAVBAR Visibility  -- reduce opacity when expanded

               $('#navContainer').on('show.bs.collapse', function () {
                   $('#navContainer').addClass("opacity-9");
                   $('#navContainer').addClass("dcoHeaderLimit");
               });

               $('#navContainer').on('hide.bs.collapse', function () {
                   $('#navContainer').removeClass("opacity-9");

               });

               var navbar_visible = $("#navContainer").is(":visible");

               if (!navbar_visible) {

                   $('#navContainer').removeClass("dcoHeaderLimit");

               }

               //removed code below because it creates a glitch on mobile that unexpectedly keeps the menu open.

               //$(window).resize(function(){
               //    navbar_visible = $("#btnNavToggler").is(":visible"); 
               //   if (!navbar_visible)
               //        $('#navContainer').removeClass("opacity-9");

               //        $('#navbarSupportedContent').collapse('hide');

               // });

               //------------------------------------------- SCROLLING

               $('#back-to-top').css("display", "none");

               $(window).scroll(function () {
                   if ($(this).scrollTop() > 100) {
                       $('#back-to-top').css("display", "block");
                   } else {
                       $('#back-to-top').css("display", "none");
                   }

               });

               $('#back-to-top').click(function () {
                   $('body,html').animate({
                       scrollTop: 0
                   }, 400);
                   return false;
               });

               //error checking... Should be called last, after other code has ran. If there is an error we want it to take priority.
               var errEle = document.getElementById('errorFSList');
               //validationstatus.ascx uses a control called "errorDataList", if it is present on the page at all, we have errors and need to set focus for sightless users.
               focusIfError(errEle);

           });


           function ShowHideCommon(elem, li) {

               var el = document.getElementById(elem);

               if (el.style.display == "none") {
                   el.style.display = "block";
                   if (li != null) {
                       li.style.listStyleImage = "url('../../Images/collapse.gif')";
                   }
               }
               else {
                   el.style.display = "none";
                   if (li != null) {
                       li.style.listStyleImage = "url('../../Images/expand.gif')";
                   }
               }

           }

           function togAttyPrIcon(aID, divID) {
               //the link
               let ele = document.getElementById(aID);
               //the container
               let ctn = document.getElementById(divID);
               if (ele) {
                   //the li that holds the icon style
                   let li = ele.parentElement;
                   if (ctn.classList.contains('show')) {
                       li.style.listStyleImage = "url('../../Images/expand.gif')";
                   }
                   else {
                       li.style.listStyleImage = "url('../../Images/collapse.gif')";
                   }
               }
           }

           //function displayContentPage(show) {
           //    //alert("here");
           //    debugger;
           //    var el = document.getElementById('cpl');
           //    el.style.visibility = show;
           //}

           function scrollTo(id) {
               var element = document.getElementById(id);
               if (typeof element == 'undefined' || element == null) { return; }
               var headerOffset = 60;
               var elementPosition = element.offsetTop;
               var offsetPosition = elementPosition - headerOffset;
               document.documentElement.scrollTop = offsetPosition;
               document.body.scrollTop = offsetPosition; // For Safari
           }


           function showPage(element, section, subsection) {
               //debugger;
               //var el = document.getElementById('cpl');        
               $('#cpl').css('display', 'none');
               $('.directive').css('display', 'none');
               $('#' + element).css('display', 'block');
               $('.collapse').collapse("hide");
               if (typeof section != 'undefined') {
                   //debugger;
                   scrollTo(section);
                   //$('#faqFamNameChange').click();
                   //document.getElementById(section).scrollIntoView({ behavior: 'instant', block: 'center' });
               }

           }

           function gotoFAQSection(element, section, subsection) {
               //debugger;
               showPage(element, section);
               $('#' + section).click();
               if (typeof subsection != 'undefined') {
                   $('#' + subsection).click();
               };

           }

           function OpenPrintRcpt(strLookupName, h, w) {
               var objLookup;

               objLookup = window.open(strLookupName, 'PrintReceipt', 'height=' + h + ',width=' + w + ',menubar=yes,resizable=yes,scrollbars=yes,toolbar=yes');
               objLookup.focus();
           }

           function OpenPopup(strLookupName, title, w, h) {
               var objLookup;

               objLookup = window.open(strLookupName, title, 'height=' + h + ',width=' + w + ',menubar=yes,resizable=yes,scrollbars=yes,toolbar=yes');
               objLookup.focus();
           }

           function OpenHint(strLookupName, strWindowTitle) {
               var objLookup;
               if (strWindowTitle == null)
                   strWindowTitle = 'Lookup';
               objLookup = window.open(strLookupName, strWindowTitle, 'height=680,menubar=no,resizable=yes,scrollbars=yes,toolbar=no,width=720');
               objLookup.focus();
               return true;
           }

           function ViewDoc(intDocNum, CourtID, docPreviewPage) {
               var objLookup;
               if (docPreviewPage == null)
                   docPreviewPage = 'DocPreview.aspx';
               objLookup = window.open(docPreviewPage + '?BasketStamp=' + intDocNum + '&CourtID=' + CourtID, 'Lookup', 'height=500,width=750,menubar=no,resizable=yes,scrollbars=yes,toolbar=no');
               objLookup.focus();
               return false;
           }

           function setCookie(cookieName, cookieValue, expireDays) {
               var expireDate = new Date();
               expireDate.setDate(expireDate.getDate() + expireDays);
               document.cookie = cookieName + "=" + escape(cookieValue) +
                   ((expireDays == null) ? "" : ";expires=" + expireDate.toGMTString());
           }

           function onViewImageClose() {
               $("#pContent").html("");
           }

           function openModalpopUp(uri) {
               $("#popup").bPopup({ content: 'iframe', contentContainer: '#pContent', loadUrl: uri, onClose: onViewImageClose });
           }

           function getCookie(cookieName) {
               if (document.cookie.length > 0) {
                   startPosition = document.cookie.indexOf(cookieName + "=");
                   if (startPosition != -1) {
                       startPosition = startPosition + cookieName.length + 1;
                       endPosition = document.cookie.indexOf(";", startPosition);
                       if (endPosition == -1)
                           endPosition = document.cookie.length;
                       return unescape(document.cookie.substring(startPosition, endPosition));
                   }
               }
               return "";
           }

           var cookieEnabled = (navigator.cookieEnabled) ? true : false

           //if not IE4+ nor NS6+
           if (typeof navigator.cookieEnabled == "undefined" && !cookieEnabled) {
               document.cookie = "testcookie"
               cookieEnabled = (document.cookie.indexOf("testcookie") != -1) ? true : false
           }
           // -->

           function KeyDownHandler(btn, event) {
               var element = document.getElementById(btn);
               // process only the Enter key
               if (event.keyCode == 13) {
                   event.returnValue = false;
                   event.cancel = true;

                   element.click();
               }
           }

       </script>
   
       <script language="javascript" type="text/javascript">

           function body_onload_handler() {
               if (window.body_onload != null) {
                   window.body_onload();
               }

               //googles tags create wcag errors in f12 console. Fix to prevent them from failing us on wcag cert.
               fixGoogleErrors();
               removehiddenElements();
               addGoogleLinkDescription();
               addGoogleRoles();
           }

           //wcag♿ fix: Add description explaining that link will open in a new window.
           function addGoogleLinkDescription() {
               //grab the google div element.
               let gDiv = document.getElementById('google_translate_element');
               if (gDiv) {
                   //link doesn't have id, so grab it by searching inside the google element.
                   let gLink = gDiv.getElementsByTagName('a');
                   if (gLink[0]) {
                       gLink[0].ariaLabel = 'Google translate link, opens in a new window.';
                   }
               }
           }

           function addGoogleRoles() {

               let ctn = document.getElementById('goog-gt-tt');
               if (ctn) {
                   let all = ctn.getElementsByTagName('svg');
                   if (all.length > 0) {
                       for (let i = 0; i < all.length; i++) {
                           all[i].role = 'presentation';
                       }
                   }
               }




           }

       </script>
   
