"id\":\"related-stories\",\"className\":\"font-serif text-3xl font-semibold text-gray-100 mb-6\",\"children\":\"Related failures\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-6 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2\",\"children\":[[\"$\",\"article\",\"kansas-chatgpt-fabricated-citations-sanctions\",{\"className\":\"tombstone-card group min-w-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-start gap-4\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/story/kansas-chatgpt-fabricated-citations-sanctions/\",\"className\":\"flex-shrink-0\",\"aria-label\":\"Read Five Kansas attorneys face sanctions for ChatGPT-fabricated court citations\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-12 h-12 bg-gray-800 rounded-lg overflow-hidden ring-1 ring-gray-700/60 group-hover:bg-gray-700 transition-colors relative\",\"children\":[\"$\",\"$L2b\",null,{\"src\":\"/tombstone-engraved.svg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"48px\",\"priority\":false,\"className\":\"object-contain p-2 opacity-95 group-hover:opacity-100 transition-opacity\"}]}]}],[\"$\",\"div\",null,{\"className\":\"flex-grow min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-start justify-between gap-2 mb-2\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"min-w-0 flex-1 font-serif font-semibold text-lg text-gray-100 group-hover:text-white transition-colors line-clamp-2\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/story/kansas-chatgpt-fabricated-citations-sanctions/\",\"children\":\"Five Kansas attorneys face sanctions for ChatGPT-fabricated court citations\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-shrink-0\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-400 font-mono\",\"children\":\"Jan 2026\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3 line-clamp-3\",\"children\":\"Five attorneys who signed a legal brief for Lexos Media IP LLC in a patent infringement case against Overstock.com submitted fabricated case citations hallucinated by ChatGPT to a federal court in Kansas. Senior U.S. District Judge Julie Robinson issued an order requiring them to explain why they should not be sanctioned, with multiple defects attributed to AI including nonexistent lawsuits, made-up judicial quotes, and citations to real cases that held the opposite of what the brief claimed.\"}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-wrap items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"severity-badge severity-facepalm\",\"children\":\"Facepalm\"}],[\"$\",\"span\",null,{\"className\":\"min-w-0 text-xs text-gray-500\",\"children\":[\"by \",\"AI chatbot\"]}]]}],[\"$\",\"span\",null,{\"className\":\"block w-full min-w-0 truncate text-xs text-gray-500 sm:w-auto sm:max-w-32 sm:text-right\",\"children\":\"Five attorneys and their client in federal court\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap gap-1\",\"children\":[[[\"$\",\"$L3\",\"ai-hallucination\",{\"href\":\"/tags/ai-hallucination/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"AI Hallucination\"}],[\"$\",\"$L3\",\"legal-risk\",{\"href\":\"/tags/legal-risk/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"Legal Risk\"}],[\"$\",\"$L3\",\"vibe-lawyering\",{\"href\":\"/tags/vibe-lawyering/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"Vibe-Lawyering\"}]],[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":[\"+\",1,\" more\"]}]]}]]}]]}]}],[\"$\",\"article\",\"new-mexico-sandoval-ai-fabricated-witnesses\",{\"className\":\"tombstone-card group min-w-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-start gap-4\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/story/new-mexico-sandoval-ai-fabricated-witnesses/\",\"className\":\"flex-shrink-0\",\"aria-label\":\"Read An AI-assisted appeal brief supplied witnesses who never testified\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-12 h-12 bg-gray-800 rounded-lg overflow-hidden ring-1 ring-gray-700/60 group-hover:bg-gray-700 transition-colors relative\",\"children\":\"$L31\"}]}],\"$L32\"]}]}],\"$L33\",\"$L34\"]}]]}]\n2a:[\"$\",\"div\",null,{\"className\":\"mt-16 pt-12 border-t border-gray-800\",\"children\":[\"$\",\"$L35\",null,{\"pageId\":\"ndcal-dal-bon-ai-citation-class-action-sanctions\"}]}]\n2c:[\"$\",\"$L3\",\"vibe-lawyering\",{\"href\":\"/tags/vibe-lawyering/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"Vibe-Lawyering\"}]\n2d:[\"$\",\"$L3\",\"ai-assistant\",{\"href\":\"/tags/ai-assistant/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"AI Assistant\"}]\n2e:[[\"$\",\"h3\",null,{\"className\":\"font-serif font-semibold text-gray-200 mb-3 mt-4\",\"children\":\"References\"}],[\"$\",\"ol\",null,{\"className\":\"list-decimal space-y-2 pl-5 marker:text-gray-500\",\"children\":[[\"$\",\"li\",\"https://blogs.duanemorris.com/classactiondefense/2026/02/03/ai-hallucinated-case-citations-prompt-sanctions-and-delay-class-action-settlement/-0\",{\"id\":\"source-1\",\"className\":\"scroll-mt-6 text-sm\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://blogs.duanemorris.com/classactiondefense/2026/02/03/ai-hallucinated-case-citations-prompt-sanctions-and-delay-class-action-settlement/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-blue-400 hover:text-blue-300 transition-colors\",\"children\":[\"Duane Morris: AI Hallucinated Case Citations Prompt Sanctions And Delay Class Action Settlement\",\" ↗\"]}]}],[\"$\",\"li\",\"https://www.law.berkeley.edu/wp-content/uploads/archive/2025/12/Buchanan.pdf-1\",{\"id\":\"source-2\",\"className\":\"scroll-mt-6 text-sm\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.law.berkeley.edu/wp-content/uploads/archive/2025/12/Buchanan.pdf\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-blue-400 hover:text-blue-300 transition-colors\",\"children\":[\"Court Filing: Buchanan v. Vuori, Case 5:23-cv-01121-NC (N.D. Cal.)\",\" ↗\"]}]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-xs leading-relaxed text-gray-500\",\"children\":[\"Source strength and correction standards are explained in the\",\" \",[\"$\",\"$L3\",null,{\"href\":\"/methodology/\",\"className\":\"text-gray-300 hover:text-white underline underline-offset-4\",\"children\":\"editorial methodology\"}],\".\"]}]]\n31:[\"$\",\"$L2b\",null,{\"src\":\"/tombstone-engraved.svg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"48px\",\"priority\":false,\"className\":\"object-contain p-2 opacity-95 group-hover:opacity-100 transition-opacity\"}]\n32:[\"$\",\"div\",null,{\"className\":\"flex-grow min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-start justify-between gap-2 mb-2\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"min-w-0 flex-1 font-serif font-semibold text-lg text-gray-100 group-hover:text-white transition-colors line-clamp-2\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/story/new-mexico-sandoval-ai-fabricated-witnesses/\",\"children\":\"An AI-assisted appeal brief supplied witnesses who never testified\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-shrink-0\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-400 font-mono\",\"children\":\"Aug 2026\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3 line-clamp-3\",\"children\":\"The New Mexico Supreme Court found that an attorney's ChatGPT-assisted appeal brief contained fabricated witnesses, invented testimony and misrepresented legal authority. The court held the attorney in contempt, ordered a $5,000 payment, barred him from appearing before it pending disciplinary proceedings and appointed replacement counsel. All briefing in the appeal was stricken.\"}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-wrap items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"severity-badge severity-facepalm\",\"children\":\"Facepalm\"}],[\"$\",\"span\",null,{\"className\":\"min-w-0 text-xs text-gray-500\",\"children\":[\"by \",\"Attorney\"]}]]}],[\"$\",\"span\",null,{\"className\":\"block w-full min-w-0 truncate text-xs text-gray-500 sm:w-auto sm:max-w-32 sm:text-right\",\"children\":\"Appeal briefing stricken; replacement counsel appointed; attorney held in contempt and referred for discipline\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap gap-1\",\"children\":[[[\"$\",\"$L3\",\"ai-hallucination\",{\"href\":\"/tags/ai-hallucination/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"AI Hallucination\"}],[\"$\",\"$L3\",\"legal-risk\",{\"href\":\"/tags/legal-risk/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"Legal Risk\"}],[\"$\",\"$L3\",\"vibe-lawyering\",{\"href\":\"/tags/vibe-lawyering/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"Vibe-Lawyering\"}]],[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":[\"+\",1,\" more\"]}]]}]]}]\n33:[\"$\",\"article\",\"nippon-chatgpt-fire-lawyer-illinois\",{\"className\":\"tombstone-card group min-w-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-start gap-4\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/story/nippon-chatgpt-fire-lawyer-illinois/\",\"className\":\"flex-shrink-0\",\"aria-label\":\"Read ChatGPT convinced Illinois woman to fire her lawyer and file 60+ bogus court documents\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-12 h-12 bg-gray-800 rounded-lg overflow-hidden ring-1 ring-gray-700/60 group-hover:bg-gray-700 transition-colors relative\",\"children\":[\"$\",\"$L2b\",null,{\"src\":\"/tombstone-engraved.svg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"48px\",\"priority\":false,\"className\":\"object-contain p-2 opacity-95 group-hover:opacity-100 transition-opacity\"}]}]}],[\"$\",\"div\",null,{\"className\":\"flex-grow min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-start justify-between gap-2 mb-2\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"min-w-0 flex-1 font-serif font-semibold text-lg text-gray-100 group-hover:text-white transition-colors line-clamp-2\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/story/nippon-chatgpt-fire-lawyer-illinois/\",\"children\":\"ChatGPT convinced Illinois woman to fire her lawyer and file 60+ bogus court documents\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-shrink-0\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-400 font-mono\",\"children\":\"Mar 2026\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3 line-clamp-3\",\"children\":\"Nippon Life Insurance Company sued OpenAI after ChatGPT allegedly acted as a de facto lawyer for Graciela Dela Torre, an Illinois disability claimant who had already settled her case. When her real attorney told her the settlement couldn't be reopened, she asked ChatGPT if she'd been \\\"gaslighted.\\\" The chatbot told her to fire her lawyer, helped her draft over 60 pro se filings across two federal cases, and produced fabricated case citations including an entirely invented case called \\\"Carr v.\\\" something. Nippon is suing OpenAI for unauthorized practice of law under Illinois state law, arguing it spent huge amounts of time and money dealing with AI-generated litigation that should never have existed.\"}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-wrap items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"severity-badge severity-facepalm\",\"children\":\"Facepalm\"}],[\"$\",\"span\",null,{\"className\":\"min-w-0 text-xs text-gray-500\",\"children\":[\"by \",\"AI chatbot\"]}]]}],[\"$\",\"span\",null,{\"className\":\"block w-full min-w-0 truncate text-xs text-gray-500 sm:w-auto sm:max-w-32 sm:text-right\",\"children\":\"Two federal cases flooded with AI-generated filings; insurer forced into costly litigation over settled claim; novel unauthorized-practice-of-law lawsuit against OpenAI.\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap gap-1\",\"children\":[[[\"$\",\"$L3\",\"ai-assistant\",{\"href\":\"/tags/ai-assistant/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"AI Assistant\"}],[\"$\",\"$L3\",\"ai-hallucination\",{\"href\":\"/tags/ai-hallucination/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"AI Hallucination\"}],[\"$\",\"$L3\",\"legal-risk\",{\"href\":\"/tags/legal-risk/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"Legal Risk\"}]],[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":[\"+\",1,\" more\"]}]]}]]}]]}]}]\n4a:I[27201,[\"/_next/static/chunks/3fntmmi971322.js\"],\"IconMark\"]\n34:[\"$\",\"article\",\"avianca-chatgpt-fake-cases-sanctions\",{\"className\":\"tombstone-card group min-w-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-start gap-4\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/story/avianca-chatgpt-fake-cases-sanctions/\",\"className\":\"flex-shrink-0\",\"aria-label\":\"Read Lawyers filed ChatGPT’s imaginary cases; judge fined them\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-12 h-12 bg-gray-800 rounded-lg overflow-hidden ring-1 ring-gray-700/60 group-hover:bg-gray-700 transition-colors relative\",\"children\":[\"$\",\"$L2b\",null,{\"src\":\"/tombstone-engraved.svg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"48px\",\"priority\":false,\"className\":\"object-contain p-2 opacity-95 group-hover:opacity-100 transition-opacity\"}]}]}],[\"$\",\"div\",null,{\"className\":\"flex-grow min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 items-start justify-between gap-2 mb-2\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"min-w-0 flex-1 font-serif font-semibold text-lg text-gray-100 group-hover:text-white transition-colors line-clamp-2\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/story/avianca-chatgpt-fake-cases-sanctions/\",\"children\":\"Lawyers filed ChatGPT’s imaginary cases; judge fined them\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-shrink-0\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-400 font-mono\",\"children\":\"Jun 2023\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3 line-clamp-3\",\"children\":\"In Mata v. Avianca (S.D.N.Y.), plaintiff Roberto Mata sued the airline after a metal serving cart struck his knee during a 2019 flight. His attorney Peter LoDuca filed a brief opposing dismissal that cited six judicial decisions. When opposing counsel and the court couldn't locate any of the cited cases, Judge Kevin Castel demanded copies. It turned out attorney Steven Schwartz at the same firm had used ChatGPT to research and draft the brief, and the AI had fabricated every case, complete with fake quotes and fake internal citations. On June 22, 2023, Castel sanctioned Schwartz, LoDuca, and their firm Levidow, Levidow \u0026 Oberman with a $5,000 penalty and required them to send notices to the real judges whose names appeared in the fabricated opinions.\"}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-wrap items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"severity-badge severity-facepalm\",\"children\":\"Facepalm\"}],[\"$\",\"span\",null,{\"className\":\"min-w-0 text-xs text-gray-500\",\"children\":[\"by \",\"Legal Counsel\"]}]]}],[\"$\",\"span\",null,{\"className\":\"block w-full min-w-0 truncate text-xs text-gray-500 sm:w-auto sm:max-w-32 sm:text-right\",\"children\":\"Court sanctions; fines and mandated notices; reputational damage in legal community.\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap gap-1\",\"children\":[[[\"$\",\"$L3\",\"ai-assistant\",{\"href\":\"/tags/ai-assistant/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"AI Assistant\"}],[\"$\",\"$L3\",\"ai-hallucination\",{\"href\":\"/tags/ai-hallucination/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"AI Hallucination\"}],[\"$\",\"$L3\",\"legal-risk\",{\"href\":\"/tags/legal-risk/\",\"className\":\"tag-badge hover:text-white\",\"children\":\"Legal Risk\"}]],[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":[\"+\",1,\" more\"]}]]}]]}]]}]}]\n30:[[\"$\",\"h2\",null,{\"children\":\"Background\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Terrence Buchanan filed a wage and hour class action lawsuit against Vuori Inc., a clothing company, alleging the company underpaid him and other class members for overtime work and bonuses earned during his employment. The case, 5:23-cv-01121-NC, was filed in the U.S. District Court for the Northern District of California before Magistrate Judge Nathanael M. Cousins.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The case itself was unremarkable - wage and hour violations are among the most common class actions in federal court. The parties reached a settlement agreement, and plaintiff's counsel needed to file a motion for preliminary approval of the class settlement. This is a procedural step where the judge reviews the proposed settlement to make sure it's fair to the class members before giving the go-ahead. It's usually straightforward.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"James Dal Bon, a solo practitioner at Wisdom Law Group APC, was class counsel for the plaintiff. He submitted his memorandum of law in support of preliminary approval. That's when things fell apart.\"}],\"\\n\",[\"$\",\"h2\",null,{\"children\":\"Six AI Tools\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"\\\"As a solo practitioner under time pressure, Dal Bon admits that he used about six different AI tools to prepare his motion,\\\" Judge Cousins noted in his sanctions order.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Six AI tools on a single brief. The resulting memorandum was - in the judge's words - \\\"rife with hallucinated quotes and one nonexistent case citation.\\\" The AI-generated content included more than one bad citation. The document contained fabricated quotations attributed to real cases, quotes that those cases never actually said. And at least one case citation pointed to a case that didn't exist at all.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"On November 5, 2025, after discovering the fabrications, Judge Cousins ordered Dal Bon to show cause as to why he should not be sanctioned under Federal Rule of Civil Procedure 11(c) and referred to the court's Standing Committee on Professional Conduct under Civil Local Rule 11-6.\"}],\"\\n\",[\"$\",\"h2\",null,{\"children\":\"A failed correction\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Getting caught using AI to fabricate citations is bad. What happened next was worse.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Dal Bon submitted a corrected memorandum with a second motion for preliminary approval. The corrected version still contained AI-hallucinated case law.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The attorney had been put on notice that his AI tools were generating fabricated legal authorities. He was facing a show cause order for that exact problem. And the corrected filing he submitted to fix the problem still had the same category of error. The court had given him a chance to clean up his work, and the cleanup was also defective.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Judge Cousins cited this in his November 20, 2025 sanctions order specifically: the corrected memorandum \\\"did not correct the false case law hallucinated by the AI tools.\\\" The repeat failure made a decisive difference in how the court handled the case.\"}],\"\\n\",[\"$\",\"h2\",null,{\"children\":\"Sanctions\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Dal Bon offered the court several proposed remedies: he would forfeit his attorneys' fees in the matter, file an amended motion certifying that he had verified all citations, and complete continuing legal education courses. Judge Cousins declined all of these proposals.\"}],\"\\n\",\"$L36\",\"\\n\",\"$L37\",\"\\n\",\"$L38\",\"\\n\",\"$L39\",\"\\n\",\"$L3a\",\"\\n\",\"$L3b\",\"\\n\",\"$L3c\",\"\\n\",\"$L3d\",\"\\n\",\"$L3e\",\"\\n\",\"$L3f\",\"\\n\",\"$L40\",\"\\n\",\"$L41\",\"\\n\",\"$L42\",\"\\n\",\"$L43\",\"\\n\",\"$L44\",\"\\n\",\"$L45\",\"\\n\",\"$L46\",\"\\n\",\"$L47\",\"\\n\",\"$L48\",\"\\n\",\"$L49\"]\n"])</script><script>self.__next_f.push([1,"36:[\"$\",\"p\",null,{\"children\":\"The court imposed its own sanctions:\"}]\n37:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Plaintiffs' second motion for preliminary approval of the class action settlement and the corrected motion were stricken \",[\"$\",\"strong\",null,{\"children\":\"with prejudice\"}],\" - meaning they could not be refiled.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Dal Bon was ordered to pay $250 to the clerk of court by December 5, 2025, under Rule 11(c).\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Dal Bon was referred to the court's Standing Committee on Professional Conduct in connection with his violation of Local Rule 11-4 and unprofessional conduct.\"}],\"\\n\"]}]\n38:[\"$\",\"p\",null,{\"children\":\"The $250 fine was the smallest part of the order. The striking of the motions with prejudice and the referral to professional conduct proceedings were far more consequential.\"}]\n39:[\"$\",\"p\",null,{\"children\":\"Judge Cousins referenced a growing body of case law on AI sanctions: \\\"Courts that have sanctioned similar violations of Rule 11(b) - namely, filing hallucinated or otherwise false case citations and quotations - have imposed a range of sanctions, often in combination, including monetary sanctions, striking the filing containing erroneous citations, requiring written notification to the client, requiring written notification to judges incorrectly identified as having authored nonexistent cases, and referring attorneys to the appropriate disciplinary body for disciplinary proceedings.\\\"\"}]\n3a:[\"$\",\"h2\",null,{\"children\":\"Inadequate Class Counsel\"}]\n3b:[\"$\",\"p\",null,{\"children\":\"The most significant finding was Judge Cousins' determination that he \\\"cannot find Dal Bon is adequate class counsel based on his representation in the case thus far.\\\" This finding, while stopping short of formally removing Dal Bon from the case, effectively killed the class action.\"}]\n3c:[\"$\",\"p\",null,{\"children\":\"Class actions require adequate representation. The named plaintiff represents thousands of absent class members who are relying on their attorney to handle the case competently. If the court finds that class counsel is inadequate, the class can't be certified, and any class settlement can't be approved. Without class certification, there is no class action.\"}]\n3d:[\"$\",\"p\",null,{\"children\":\"The sanctions prohibited Dal Bon from filing any further motions to approve a class settlement. The class members - Vuori workers allegedly owed unpaid wages and bonuses - couldn't get their settlement approved because their own attorney's AI-drafted brief torpedoed the proceeding.\"}]\n3e:[\"$\",\"h2\",null,{\"children\":\"An individual settlement instead\"}]\n3f:[\"$\",\"p\",null,{\"children\":\"On January 7, 2026, counsel for Vuori filed a case management statement explaining the aftermath. The parties had signed a settlement agreement containing \\\"a general release of Plaintiff's claims against Defendant,\\\" and per the terms of that agreement, Buchanan was obligated to dismiss the action with prejudice by December 31, 2025.\"}]\n40:[\"$\",\"p\",null,{\"children\":\"On January 9, 2026, Judge Cousins granted a joint dismissal. The case ended with a confidential individual settlement between Buchanan and Vuori. Dal Bon signed the dismissal motion alongside Vuori's counsel.\"}]\n41:[\"$\",\"p\",null,{\"children\":\"The critical difference: the class action settlement would have covered all the workers affected by Vuori's alleged wage practices. The individual settlement covered only Terrence Buchanan. The other class members - however many workers had similar claims against Vuori - got nothing. Their claims were not released by Buchanan's individual settlement, but they also no longer had a pending class action to join or benefit from.\"}]\n42:[\"$\",\"h2\",null,{\"children\":\"A solo practitioner problem\"}]\n43:[\"$\",\"p\",null,{\"children\":\"Dal Bon's case illustrates a specific risk pattern in AI-assisted legal work. Solo practitioners and small firms face the same filing deadlines and procedural requirements as large firms, with a fraction of the resources. AI tools promise to close that gap - generate a brief in hours instead of days, produce research that would take associates at a large firm to compile.\"}]\n44:[\"$\",\"p\",null,{\"children\":\"The problem is that the verification step doesn't scale down. A large firm has associates to cross-check citations, partners to review drafts, and librarians to verify sources. A solo practitioner using six AI tools to generate a brief is also the only person who can verify the output. When the time pressure that led to using AI in the first place also prevents thorough verification, the attorney is submitting AI-generated content on trust.\"}]\n45:[\"$\",\"p\",null,{\"children\":\"Dal Bon said he was \\\"under time pressure.\\\" The AI tools were supposed to help him meet that pressure. Instead, they introduced fabrications that he did not catch, and when given a second chance, he still did not catch them. The tools didn't solve his capacity problem. They transformed it from \\\"not enough time to write a brief\\\" into \\\"not enough time to verify a brief I didn't write.\\\"\"}]\n46:[\"$\",\"h2\",null,{\"children\":\"Impact on the Plaintiffs\"}]\n47:[\"$\",\"p\",null,{\"children\":\"The Duane Morris analysis of Buchanan noted an implication for class action defense: employers should \\\"review class counsel's filings scrupulously by noting any citations or quotations that seem incorrect and AI-generated as this may build a case for disqualifying class counsel and may prove as a barrier to getting approval of a class settlement agreement.\\\"\"}]\n48:[\"$\",\"p\",null,{\"children\":\"That's the defense bar reading this decision as a new tactical tool. If class counsel uses AI and the output contains errors, the defense can move to disqualify that counsel and potentially kill the class action. In effect, one attorney's AI error sanctions that attorney and can destroy the case for the entire class.\"}]\n49:[\"$\",\"p\",null,{\"children\":\"The workers in Buchanan v. Vuori alleged they were underpaid. Their attorney used AI to save time. The AI generated fabricated law. The attorney missed it twice. The court struck the settlement and found counsel inadequate. The class action collapsed into an individual settlement. The workers' claims survived in theory but lost their vehicle in practice.\"}]\n1d:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n1b:null\n1f:[[\"$\",\"title\",\"0\",{\"children\":\"AI-hallucinated citations delay wage class action...\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"A federal judge in the Northern District of California sanctioned plaintiff's counsel James Dal Bon in Buchanan v. Vuori Inc. (Case 5:23-cv-01121-NC) for...\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"Vibe Graveyard\"}],[\"$\",\"meta\",\"3\",{\"name\":\"creator\",\"content\":\"Vibe Graveyard\"}],[\"$\",\"meta\",\"4\",{\"name\":\"publisher\",\"content\":\"Vibe Graveyard\"}],[\"$\",\"meta\",\"5\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"6\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"7\",{\"name\":\"theme-color\",\"content\":\"#030712\"}],[\"$\",\"link\",\"8\",{\"rel\":\"canonical\",\"href\":\"https://vibegraveyard.ai/story/ndcal-dal-bon-ai-citation-class-action-sanctions/\"}],[\"$\",\"meta\",\"9\",{\"name\":\"google-site-verification\",\"content\":\"d2NtG68zsmCd7zh5IHrr-UjwaMI6HkGJMgighKEJPu8\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:title\",\"content\":\"AI-hallucinated citations delay wage class action...\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:description\",\"content\":\"A federal judge in the Northern District of California sanctioned plaintiff's counsel James Dal Bon in Buchanan v. Vuori Inc. (Case 5:23-cv-01121-NC) for...\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image\",\"content\":\"https://vibegraveyard.ai/story/ndcal-dal-bon-ai-citation-class-action-sanctions/opengraph-image.png\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"14\",{\"property\":\"article:published_time\",\"content\":\"2026-03-06\"}],[\"$\",\"meta\",\"15\",{\"property\":\"article:author\",\"content\":\"Vibe Graveyard\"}],[\"$\",\"meta\",\"16\",{\"property\":\"article:tag\",\"content\":\"ai-hallucination\"}],[\"$\",\"meta\",\"17\",{\"property\":\"article:tag\",\"content\":\"legal-risk\"}],[\"$\",\"meta\",\"18\",{\"property\":\"article:tag\",\"content\":\"vibe-lawyering\"}],[\"$\",\"meta\",\"19\",{\"property\":\"article:tag\",\"content\":\"ai-assistant\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:title\",\"content\":\"AI-hallucinated citations delay wage class action...\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:description\",\"content\":\"A federal judge in the Northern District of California sanctioned plaintiff's counsel James Dal Bon in Buchanan v. Vuori Inc. (Case 5:23-cv-01121-NC) for...\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:image\",\"content\":\"https://vibegraveyard.ai/story/ndcal-dal-bon-ai-citation-class-action-sanctions/opengraph-image.png\"}],[\"$\",\"link\",\"24\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.3q8prrbzzt7-2.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/icon.svg\"}],[\"$\",\"link\",\"26\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"$L4a\",\"27\",{}]]\n"])</script></body></html>